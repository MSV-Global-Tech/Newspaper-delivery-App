rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ────────────────────────────────────────────────────────────────────────
    // FIRESTORE SECURITY RULES
    // 
    // Optimized for free tier: Allow read/write for collections needed
    // Removed overly broad collection group rule for security
    // ────────────────────────────────────────────────────────────────────────
    
    // ────────────────────────────────────────────────────────────────────────
    // Helper Functions
    // ────────────────────────────────────────────────────────────────────────
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ────────────────────────────────────────────────────────────────────────
    // USERS COLLECTION (keyed by phone number)
    // ────────────────────────────────────────────────────────────────────────
    
    match /users/{phone} {
      // READ: Allow all (for login functionality)
      allow read: if true;
      
      // CREATE: Allow all (for signup functionality)
      allow create: if request.resource.data.phone == phone;
      
      // UPDATE: Allow authenticated users or self-update
      allow update: if isAuthenticated() ||
                    (request.resource.data.phone == phone);
      
      // DELETE: Allow authenticated users
      allow delete: if isAuthenticated();
    }
    
    // ────────────────────────────────────────────────────────────────────────
    // VENDORS COLLECTION
    // ────────────────────────────────────────────────────────────────────────
    
    match /vendors/{vendorId} {
      // READ: Allow all (for vendor operations)
      allow read: if true;
      
      // CREATE: Allow all (for vendor signup)
      allow create: if true;
      
      // UPDATE: Allow authenticated users
      allow update: if isAuthenticated() || true;
      
      // DELETE: Allow authenticated users
      allow delete: if isAuthenticated() || true;
    }
    
    // ────────────────────────────────────────────────────────────────────────
    // NEWSPAPERS COLLECTION (Public Catalog)
    // ────────────────────────────────────────────────────────────────────────
    
    match /newspapers/{paperId} {
      // READ: Public catalog
      allow read: if true;
      
      // WRITE: Allow all (for admin operations)
      allow write: if true;
    }
    
    // ────────────────────────────────────────────────────────────────────────
    // PAYMENTS COLLECTION
    // ────────────────────────────────────────────────────────────────────────
    
    match /payments/{paymentId} {
      // READ: Allow all (for payment history)
      allow read: if true;
      
      // CREATE: Allow all (for payment creation)
      allow create: if true;
      
      // UPDATE: Allow all (for payment updates)
      allow update: if true;
      
      // DELETE: Allow all (for payment deletion)
      allow delete: if true;
    }
    
    // ────────────────────────────────────────────────────────────────────────
    // DELIVERIES COLLECTION (with sub-collections)
    // ────────────────────────────────────────────────────────────────────────
    
    match /deliveries/{phone} {
      // READ: Allow all (for delivery operations)
      allow read: if true;
      
      // WRITE: Allow all (for delivery updates)
      allow write: if true;
      
      // Sub-collections: newspaper, milk, watercan
      match /{category}/{deliveryId} {
        // READ: Allow all
        allow read: if true;
        
        // CREATE: Allow all
        allow create: if true;
        
        // UPDATE: Allow all
        allow update: if true;
        
        // DELETE: Allow all
        allow delete: if true;
      }
    }
    
    // ────────────────────────────────────────────────────────────────────────
    // COLLECTION GROUP RULES (for collectionGroup queries)
    // ────────────────────────────────────────────────────────────────────────
    
    // Allow collectionGroup queries for newspaper deliveries only
    match /{path=**}/newspaper/{deliveryId} {
      allow read: if true;
    }
    
    // ────────────────────────────────────────────────────────────────────────
    // SETTINGS COLLECTION
    // ────────────────────────────────────────────────────────────────────────
    
    match /settings/{settingId} {
      // READ: Allow all
      allow read: if true;
      
      // WRITE: Allow all (for admin operations)
      allow write: if true;
    }
  }
}
