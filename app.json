{
  "expo": {
    "name": "Newspaper Delivery",
    "slug": "newspaper-delivery-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow photo access to upload newspaper logos.",
        "NSPhotoLibraryAddUsageDescription": "Allow saving newspaper logos to your photo library."
      }
    },
    "android": {
      "package": "com.newspaper.delivery",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "abiFilters": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableProguardInReleaseBuilds": true,
            "buildTypes": {
              "release": {
                "minifyEnabled": true,
                "shrinkResources": true,
                "debuggable": false,
                "proguardFiles": [
                  "proguard-rules.pro"
                ]
              }
            }
          }
        }
      ]
    ],
    "scheme": "newspaperapp",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": ""
      }
    },
    "owner": ""
  }
}