{
  "expo": {
    "name": "Newspaper Delivery",
    "slug": "newspaper-delivery-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow photo access to upload newspaper logos.",
        "NSPhotoLibraryAddUsageDescription": "Allow saving newspaper logos to your photo library."
      }
    },
    "android": {
      "package": "com.newspaper.deliveryapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": []
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-updates",
      [
        "@react-native-firebase/app",
        {
          "android": {
            "googleServicesFile": "./google-services.json"
          }
        }
      ],
      [
        "@react-native-firebase/auth",
        {
          "android": {
            "googleServicesFile": "./google-services.json"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "abiFilters": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableProguardInReleaseBuilds": false,
            "buildTypes": {
              "release": {
                "minifyEnabled": false,
                "shrinkResources": false,
                "debuggable": false
              }
            }
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "newspaperapp",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c29ba46b-1fcc-448f-bc0d-590bef2a7186"
      }
    },
    "owner": ""
  }
}
