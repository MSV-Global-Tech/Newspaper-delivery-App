{
  "expo": {
    "name": "Newspaper Delivery",
    "slug": "newspaper-delivery-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.newspaper.delivery"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "scheme": "newspaperapp",
    "experiments": {
      "typedRoutes": true
    }
  }
}
